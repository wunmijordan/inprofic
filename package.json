{
  "private": true,
  "scripts": {
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./assets/css/tailwind.css -o ./apps/core/static/core/css/inprofic.css --minify",
    "build:ui": "esbuild assets/ui/workspace.tsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV='\"production\"' --outfile=apps/core/static/core/js/interactions.js",
    "build": "npm run build:ui && npm run build:css",
    "test:ui": "playwright test",
    "ui:inspect": "playwright-cli open",
    "skills:sync": "node scripts/ui/sync-skill.cjs"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
