# ============================================================
# INPROFIC — LOCAL DEVELOPMENT
# ============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
DEBUG=True

# Local only. Do not reuse this in production.
SECRET_KEY=

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Current INPROFIC settings use SQLite.
DATABASE_URL=sqlite:///db.sqlite3

MEDIA_URL=/media/
MEDIA_ROOT=media

CRON_SECRET=

# ============================================================
# SUBSCRIPTION PAYMENT PROVIDERS
# ============================================================

# ------------------------------------------------------------
# Paystack — TEST credentials
# ------------------------------------------------------------
# Get these from your Paystack test dashboard.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=


# ------------------------------------------------------------
# Monnify — SANDBOX credentials
# ------------------------------------------------------------
MONNIFY_API_KEY=REPLACE_WITH_SANDBOX_API_KEY
MONNIFY_SECRET_KEY=REPLACE_WITH_SANDBOX_SECRET_KEY
MONNIFY_CONTRACT_CODE=REPLACE_WITH_SANDBOX_CONTRACT_CODE

# Optional hosted PostgreSQL / Cloudflare R2 settings.
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=0
DB_POOL_MAX_SIZE=0
DB_POOL_TIMEOUT=10
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_CUSTOM_DOMAIN=
R2_REGION_NAME=auto
R2_MEDIA_LOCATION=media
CRON_SECRET=
TRUST_PROXY_SSL_HEADER=False

# Monnify sandbox
MONNIFY_BASE_URL=https://sandbox.monnify.com
